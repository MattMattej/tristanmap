# ─────────────────────────────────────────────────────────────
#  Tristán Map — variables de entorno
#  Copiá este archivo a .env.local y completá los valores.
# ─────────────────────────────────────────────────────────────

# Acceso al panel de administración (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiame-por-una-clave-larga
# Secreto para firmar la sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Dónde se guardan los datos:
#   local    -> archivo data/db.json + fotos en data/uploads (ideal para desarrollo)
#   supabase -> Postgres + Storage de Supabase (producción, capa gratuita)
DATA_DRIVER=local

# Solo si DATA_DRIVER=supabase (Supabase → Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# URL pública del sitio (para links para compartir y metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
